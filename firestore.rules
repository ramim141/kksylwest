rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* All Public Content & Management Collections */
    match /results/{doc}          { allow read, write: if true; }
    match /notices/{doc}          { allow read, write: if true; }
    match /gallery/{doc}          { allow read, write: if true; }
    match /committee/{doc}        { allow read, write: if true; }
    match /hero_slides/{doc}      { allow read, write: if true; }
    match /activities/{doc}       { allow read, write: if true; }
    match /faqs/{doc}             { allow read, write: if true; }
    match /team_structure/{doc}   { allow read, write: if true; }
    match /syllabus/{doc}         { allow read, write: if true; }
    match /upazila_centers/{doc}  { allow read, write: if true; }
    match /exam_centers/{doc}     { allow read, write: if true; }
    match /site_settings/{doc}    { allow read, write: if true; }
    match /messages/{doc}         { allow read, write: if true; }

    /* Admin Multi-Device OTP Synchronization */
    match /admin_security/{doc}   { allow read, write: if true; }

    /* Online & Offline Student Registrations */
    match /registrations/{doc}    { allow read, write: if true; }

    /* Fallback match for any other document */
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
