# ==========================================
# 👑 Admin Access
# ==========================================
# Admin login now goes through Google sign-in (Firebase Authentication).
# The allowed account lives in src/context/AuthContext.jsx and firestore.rules,
# not here — anything in this file is inlined into the public bundle by Vite.

# ==========================================
# 🔥 Firebase Configuration
# ==========================================
# Firebase Console (https://console.firebase.google.com) থেকে আপনার Web App Config গুলো এখানে বসান:
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# ==========================================
# 📸 ImgBB API Configuration
# ==========================================
# ImgBB (https://api.imgbb.com) থেকে আপনার Free API Key টি এখানে বসান:
VITE_IMGBB_API_KEY=YOUR_IMGBB_API_KEY
